# ============================================================
# Metagov Bot Configuration
# Copy this file to .env and fill in your values
# ============================================================

# Optional public organization profile. A name loads profiles/<name>.json;
# a JSON path loads that file directly. Environment variables override it.
# METAGOV_PROFILE=example

# --- Required ---

# Bot wallet private key (with or without 0x prefix — both work)
# This wallet must be added as a signer on your Safe (threshold 1)
# and funded with ~0.1 ETH for gas
BOT_PRIVATE_KEY=

# Your Safe multisig address (not required when provided by a profile)
SAFE_ADDRESS=

# Your Snapshot space ID (not required when provided by a profile)
SNAPSHOT_SPACE_ID=

# --- Optional (sensible defaults) ---

# Ethereum RPC endpoint (any mainnet RPC works)
ETHEREUM_RPC_URL=https://eth.llamarpc.com

# Nouns subgraph URL — default is the public Goldsky subgraph
# Ask indexcard for one if needed
NOUNS_GRAPHQL_ENDPOINT=

# Nouns DAO contract address (default: Nouns DAO mainnet)
NOUNS_DAO_ADDRESS=0x6f3E6272A167e8AcCb32072d08E0957F9c79223d

# Safe Transaction Service API key (optional — only used to show
# transactions in the Safe web UI, not required for execution)
SAFE_API_KEY=

# Nouns client incentives ID (default: 0)
CLIENT_ID=0

# Proposal timing follows the Snapshot space settings by default.
# Uncomment either value only when this bot should override the space.
# SNAPSHOT_VOTING_DELAY_SECONDS=0
# VOTING_DURATION_DAYS=5

# What happens when no Snapshot votes are cast: "abstain" or "skip"
NO_VOTES_ACTION=abstain

# Minimum Nouns proposal ID to process (skip older proposals)
MIN_PROPOSAL_ID=0

# How far back to look for proposals on startup (days)
LOOKBACK_DAYS=7

# URL template for proposal links — use {id} as placeholder for Nouns proposal ID
PROPOSAL_LINK_TEMPLATE=https://nouns.wtf/vote/{id}

# Polling intervals (minutes)
PROPOSAL_POLL_MINUTES=1
VOTE_POLL_MINUTES=5

# Directory for persistent state files (useful for Docker volume mounts)
DATA_DIR=data

# Gas settings
MAX_GAS_PRICE_GWEI=100
MAX_RETRIES=3

# Set to true to log actions without executing anything
DRY_RUN=true
